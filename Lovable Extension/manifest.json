{
  "manifest_version": 3,
  "name": "Lovable Enhancer Pro",
  "version": "1.0.0",
  "description": "Side panel interface + Subscription & Trial Mode.",
  "author": "VIBE CODING DETECTIVE TEAM",
  "permissions": ["storage", "activeTab", "tabs", "alarms", "sidePanel", "offscreen"],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://*.lovable.app/*",
    "https://lovable-api.com/*",
    "https://lovable-pro-server.vercel.app/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*"],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Lovable Enhancer Pro"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "web_accessible_resources": [
    { "resources": ["content/inject_v2.js", "lib/fingerprint.js"], "matches": ["https://lovable.dev/*"] }
  ]
}